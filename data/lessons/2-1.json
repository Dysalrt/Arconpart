      "type": "T",
      "title": "Three basic tenses",
      "theory": "Arcon verbs do not change for person or number. Type 1 uses <b>-da / -de / -do</b>; Type 2 uses <b>-a / -e / -o</b> for past, present, and future.",
      "examples": [
        {
          "word": "ro → rode",
          "ipa": "—",
          "translation": "go → present"
        },
        {
          "word": "ro → rodo",
          "ipa": "—",
          "translation": "go → future"
        },
        {
          "word": "cep → cepa",
          "ipa": "—",
          "translation": "speak → past"
        }
      ]
    },
    {
      "type": "E",
      "Etype": "choice",
      "prompt": "Which ending marks the future for a Type 2 verb?",
      "ipaHint": null,
      "options": [
        "-do",
