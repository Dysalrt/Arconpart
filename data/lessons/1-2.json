    {
      "type": "T",
      "title": "Showing possession",
      "theory": "Remember Type 1 / Type 2? It comes back here too. To say \"my\", \"your\", \"his\"... take the pronoun and add: Type 1 (ends in a vowel) → +s. Type 2 (ends in a consonant) → +is.",
      "examples": [
        { "word": "vi → vis", "ipa": "", "translation": "I → my (Type 1: vowel)" },
        { "word": "vy → vys", "ipa": "", "translation": "you → your (Type 1: vowel)" },
        { "word": "Al → Alis", "ipa": "", "translation": "he → his (Type 2: consonant)" },
        { "word": "Ul → Ulis", "ipa": "", "translation": "she → her (Type 2: consonant)" }
      ]
    },
    {
