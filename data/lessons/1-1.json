  "lesson": [
    {
      "type": "T",
      "title": "Классы слов",
      "theory": "Классы слов используются для того чтобы понимать как правильно менять слова в зависимости от их нужной роли",
      "examples": []
    },
    {
      "type": "T",
      "title": "Класс I",
      "theory": "Слова которые заканчиваются на гласные принадлежат первому классу слов\nПримеры:",
      "examples": [
        {
          "word": "~i~",
          "ipa": "",
          "translation": "Я"
        },
        {
          "word": "~you~",
          "ipa": "",
          "translation": "Ты"
        }
      ]
    },
    {
      "type": "T",
      "title": "Класс II",
      "theory": "Слова которые заканчиваются на согласные принадлежат второму классу слов\nПримеры:",
      "examples": [
        {
          "word": "~he~",
          "ipa": "",
          "translation": "он"
        },
        {
          "word": "~she~",
          "ipa": "",
          "translation": "она"
        }
      ]
    },
    {
      "type": "E",
      "Etype": "choice",
      "prompt": "Выберите слово из класса 1",
      "ipaHint": null,
      "options": [
        "~i~",
        "~he~",
        "~she~"
      ],
      "answer": "~i~"
    },
    {
      "type": "E",
      "Etype": "choice",
      "prompt": "Выберите слово из класса 2",
      "ipaHint": null,
      "options": [
        "~i~",
        "~you~",
        "~he~"
      ],
      "answer": "~he~"
    }
  ]
}